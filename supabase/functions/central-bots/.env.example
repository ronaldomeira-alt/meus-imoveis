# Server-only settings. Supabase injects SUPABASE_URL/ANON_KEY/SERVICE_ROLE_KEY.
# Keep disabled until migration, authentication and protected regression checks pass.
CENTRAL_BOTS_ENABLED=false
MARKETING_BOT_ENABLED=false
# Prices verified against https://console.groq.com/docs/models on 2026-10-04.
# USD per million tokens; adjust and reverify when changing model/provider.
MARKETING_MODEL_PRICES={"openai/gpt-oss-20b":{"input":0.075,"output":0.30}}
# Explicit tenant binding for legacy Instagram tables (no implicit first-account lookup).
MARKETING_INSTAGRAM_ACCOUNT_ID=
MARKETING_INSTAGRAM_CONNECTION_ID=
MARKETING_INSTAGRAM_LOGIN=instagram
# Keep version compatible with the existing publishing connection.
META_GRAPH_VERSION=v21.0
# Optional broad search. Feeds remain usable without this credential.
MARKETING_BRAVE_API_KEY=
MARKETING_SEARCH_MAX_USD=
# Additional exact HTTPS domains, authorized by the operator; no wildcards.
MARKETING_SOURCE_DOMAINS=
APP_ORIGIN=https://ronaldomeira.com.br
CENTRAL_ADMIN_EMAIL=ronaldomeira@gmail.com
AGENT_AI_PROVIDER=groq
AGENT_GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
MEUS_IMOVEIS_ACCOUNT_ID=52716edc-399e-4d4c-9788-0d6b04c0031f
MATCH_CANONICAL_ACCOUNT_ID=7f434d39-87d8-4d16-8262-e3006908d1c5
# Optional server alternatives: OPENAI_API_KEY, GEMINI_API_KEY,
# AGENT_OPENAI_MODEL, AGENT_GEMINI_MODEL. Never prefix secrets with VITE_.
# Optional local development CORS: CENTRAL_DEV_ORIGIN=http://127.0.0.1:5180
# The separate public frontend flag is VITE_CENTRAL_BOTS_ENABLED=true.
# Deploy only central-bots; JWT and scoped cron authentication live in handler.js.
