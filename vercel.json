{
  "rewrites": [
    {
      "source": "/imoveis/p/:token",
      "destination": "/api/public-page?token=:token"
    },
    {
      "source": "/imovel/:id/og.jpg",
      "destination": "/api/og-image?id=:id"
    },
    {
      "source": "/imovel/:id",
      "destination": "/api/public-page?id=:id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
